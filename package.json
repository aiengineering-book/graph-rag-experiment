{
  "name": "graph-rag-experiment",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "ingest": "tsx --env-file=.env src/cli/ingest.ts",
    "eval": "tsx --env-file=.env src/cli/eval.ts",
    "build-graph": "tsx --env-file=.env src/cli/build-graph.ts",
    "update-cost": "tsx --env-file=.env src/cli/update-cost.ts",
    "report": "tsx src/cli/report.ts",
    "export-graph": "tsx --env-file=.env src/cli/export-graph.ts",
    "import-graph": "tsx --env-file=.env src/cli/import-graph.ts",
    "export-prompts": "tsx --env-file=.env src/cli/export-prompts.ts",
    "run-prompts": "tsx --env-file=.env src/cli/run-prompts.ts",
    "score-answers": "tsx src/cli/score-answers.ts"
  },
  "dependencies": {
    "postgres": "^3.4.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@types/node": "^22.0.0"
  }
