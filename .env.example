# Postgres from docker-compose.yml
DATABASE_URL=postgres://postgres:postgres@localhost:5433/graphrag
# Local embeddings (ollama pull nomic-embed-text)
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text
# Chat model: any OpenAI Chat Completions-compatible API
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# Hard stop: the run aborts when prompt + completion tokens reach this total
TOKEN_BUDGET=2000000
